rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ข้อมูลทั้งหมดของแต่ละบัญชี: อ่านและเขียนได้เฉพาะเจ้าของบัญชีที่ล็อกอินอยู่
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // กล่องรับแจ้งเตือนจากมือถือ (แอปอัตโนมัติบน Android):
    // เขียนเพิ่มได้อย่างเดียว (อ่าน/แก้/ลบไม่ได้ นอกจากเจ้าของที่ล็อกอิน)
    // ต้องมีรหัสลับตรงกับที่เก็บไว้ใน users/{uid}/meta/inbox
    match /users/{uid}/inbox/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text','k','at','ts','src'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 1500
        && request.resource.data.k is string
        && request.resource.data.k == get(/databases/$(database)/documents/users/$(uid)/meta/inbox).data.k
        && (!('at' in request.resource.data) || request.resource.data.at is int)
        && (!('ts' in request.resource.data) || (request.resource.data.ts is string && request.resource.data.ts.size() <= 25))
        && (!('src' in request.resource.data) || (request.resource.data.src is string && request.resource.data.src.size() <= 20));
    }
  }
}
